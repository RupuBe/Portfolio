# Public URL of the deployed site, with no trailing slash.
# Used to make the canonical / Open Graph / Twitter image links absolute,
# which LinkedIn, WhatsApp and X need to show a preview card.
# Example: VITE_SITE_URL=https://ruprekha.vercel.app
VITE_SITE_URL=

# Google Search Console → Add property → URL prefix → HTML tag. Paste only the
# content="..." value here, rebuild and redeploy, then click Verify.
VITE_GOOGLE_SITE_VERIFICATION=
